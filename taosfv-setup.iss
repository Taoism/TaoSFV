; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{85FAAFF2-B9D3-4676-A2DA-E055F6C06258}
AppName=TaoSFV
AppVerName=TaoSFV 2.0
AppPublisher=TaoSFV
AppPublisherURL=https://github.com/judwhite/ilSFV
AppSupportURL=https://github.com/judwhite/ilSFV
AppUpdatesURL=https://github.com/judwhite/ilSFV
DefaultDirName={pf}\TaoSFV
DefaultGroupName=TaoSFV
AllowNoIcons=yes
OutputDir=.\setup
OutputBaseFilename=TaoSFVsetup
SetupIconFile=.\TaoSFV\TaoSFV.ico
Compression=lzma
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}";

[Files]
; build with (requires the .NET 10 Desktop Runtime on the target machine):
;   dotnet publish TaoSFV\TaoSFV.csproj -c Release -r win-x64 --self-contained false -o publish
;   dotnet publish TaoSFV.Cli\TaoSFV.Cli.csproj -c Release -r win-x64 --self-contained false -o publish
Source: ".\publish\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs; Excludes: "*.pdb"
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{group}\TaoSFV"; Filename: "{app}\TaoSFV.exe"
Name: "{group}\{cm:UninstallProgram,TaoSFV}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\TaoSFV"; Filename: "{app}\TaoSFV.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\TaoSFV.exe"; Description: "{cm:LaunchProgram,TaoSFV}"; Flags: nowait postinstall skipifsilent

